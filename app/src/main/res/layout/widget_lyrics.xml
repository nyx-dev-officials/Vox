<?xml version="1.0" encoding="utf-8"?>
<!--
  Lyrics widget: one full-bleed artwork card with two states.

  Cover state: artwork, artist and title bottom-left, favourite bottom-right,
  the lyrics toggle top-right, a thin scrubber and a transport row.
  Lyrics state: the same artwork darkened, artist and title top-left, and the
  synced lyric window in the middle.

  Both states live in this one layout so the RemoteViews shape stays stable when
  the widget flips between them; the manager shows one group and hides the other.
  RemoteViews has no animation, so the lyric window steps on line change rather
  than gliding — the honest limit of the widget host.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.Vox">

    <ImageView
        android:id="@+id/widget_lyr_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_preview"
        android:contentDescription="@null" />

    <!-- ── Cover state ───────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/widget_lyr_cover_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_lyr_cover_lyrics_toggle"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:alpha="0.95"
                android:padding="2dp"
                android:src="@drawable/ic_widget_music_note"
                android:contentDescription="@string/widget_lyrics" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_lyr_cover_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.85"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/tap_to_play"
                    android:textColor="@color/widget_on_card"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_lyr_cover_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/not_playing"
                    android:textColor="@color/widget_on_card"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_lyr_cover_like"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="10dp"
                android:alpha="0.95"
                android:padding="2dp"
                android:src="@drawable/ic_widget_heart_outline_nav"
                android:contentDescription="@string/like" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="12dp">

            <ImageView
                android:id="@+id/widget_lyr_cover_progress_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.28"
                android:scaleType="fitXY"
                android:src="@drawable/widget_progress_track"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_lyr_cover_progress_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_progress_clip"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_lyr_cover_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.85"
                android:text="00:00"
                android:textColor="@color/widget_on_card"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_lyr_cover_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:text="00:00"
                android:textColor="@color/widget_on_card"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_lyr_cover_prev"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="24dp"
                android:alpha="0.95"
                android:padding="2dp"
                android:src="@drawable/ic_widget_skip_previous"
                android:contentDescription="@string/previous" />

            <LinearLayout
                android:id="@+id/widget_lyr_cover_pill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/widget_pill_scrim_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:id="@+id/widget_lyr_cover_play_pause"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_widget_play"
                    android:contentDescription="@string/play_pause" />

                <TextView
                    android:id="@+id/widget_lyr_cover_pill_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/widget_play"
                    android:textColor="@color/widget_on_card"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_lyr_cover_next"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="24dp"
                android:alpha="0.95"
                android:padding="2dp"
                android:src="@drawable/ic_widget_skip_next"
                android:contentDescription="@string/next" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Lyrics state ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/widget_lyr_lyrics_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_lyr_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/tap_to_play"
                    android:textColor="@color/widget_on_card"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_lyr_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/not_playing"
                    android:textColor="@color/widget_on_card"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_lyr_lyrics_toggle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:alpha="0.95"
                android:padding="2dp"
                android:src="@drawable/ic_widget_music_note"
                android:contentDescription="@string/widget_lyrics" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_lyr_prev2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.28"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_card"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_lyr_prev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:alpha="0.45"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_card"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_lyr_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_no_lyrics"
                android:textColor="@color/widget_on_card"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_lyr_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:alpha="0.45"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_card"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_lyr_next2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:alpha="0.28"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_card"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp">

            <ImageView
                android:id="@+id/widget_lyr_progress_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.28"
                android:scaleType="fitXY"
                android:src="@drawable/widget_progress_track"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_lyr_progress_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_progress_clip"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_lyr_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.85"
                android:text="00:00"
                android:textColor="@color/widget_on_card"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_lyr_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:text="00:00"
                android:textColor="@color/widget_on_card"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_lyr_skip_prev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="20dp"
                android:alpha="0.95"
                android:padding="2dp"
                android:src="@drawable/ic_widget_skip_previous"
                android:contentDescription="@string/previous" />

            <LinearLayout
                android:id="@+id/widget_lyr_pill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/widget_pill_scrim_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:id="@+id/widget_lyr_play_pause"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_widget_play"
                    android:contentDescription="@string/play_pause" />

                <TextView
                    android:id="@+id/widget_lyr_pill_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="@string/widget_play"
                    android:textColor="@color/widget_on_card"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_lyr_skip_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="20dp"
                android:alpha="0.95"
                android:padding="2dp"
                android:src="@drawable/ic_widget_skip_next"
                android:contentDescription="@string/next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
